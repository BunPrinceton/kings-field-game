{
  "name": "kings-field-game",
  "version": "0.1.0",
  "description": "A King's Field-inspired first-person dungeon crawler",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron-build": "npm run build && electron-builder",
    "dist-mac": "npm run build && electron-builder --mac",
    "dist-win": "npm run build && electron-builder --win",
    "dist-all": "npm run build && electron-builder --mac --win"
  },
  "keywords": ["game", "dungeon-crawler", "3d", "rpg"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "vite": "^5.0.0"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "build": {
    "appId": "com.kingsfield.game",
    "productName": "Kings Field",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "index.html",
      "public/**/*"
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "public/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  }
}
